<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <SignAssembly>True</SignAssembly>
    <IsPackable>true</IsPackable>
    <PackageId>LapViz.Telemetry</PackageId>
    <Description>Lightweight, high-performance telemetry library for motorsport timing and analytics.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\circuits.json" />
    <EmbeddedResource Include="Resources\GenkSessionWithPit.csv.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.4" />
    <PackageReference Include="System.Text.Json" Version="6.0.11" />
    <PackageReference Include="System.ComponentModel.Composition" Version="5.0.0" />
  </ItemGroup>

</Project>
